# Esta carpeta SÍ debe ser accesible (sirve las fotos), pero
# JAMÁS debe ejecutar código PHP, sin importar qué archivo
# llegue a guardarse aquí.

<FilesMatch "\.(php|php\d|phtml|pht|phar)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
