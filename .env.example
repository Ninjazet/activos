# Copia este archivo como .env para XAMPP o usa las mismas variables en Docker.
# Nunca guardes contraseñas reales dentro de .env.example.

APP_NAME=GestActivos
APP_VERSION=2.0.0
APP_BASE_URL=/activos
APP_TIMEZONE=America/Tegucigalpa

# Llave local para cifrar claves de licencias. Genera una distinta por instalación:
# C:\xampp\php\php.exe -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_ENCRYPTION_KEY=

# Dejar vacío usa public/img dentro del proyecto.
APP_STORAGE_PATH=

# XAMPP: DB_HOST=localhost. Docker Compose: normalmente DB_HOST=db.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=gestactivos
DB_CHARSET=utf8mb4
